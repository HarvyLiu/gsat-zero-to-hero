---
/**
 * Previous / next chapter cards at the end of a chapter (port of ASMC ChapterNav), within the
 * same subject and track.
 *
 * Branch points: a static page cannot know the learner's path, so where the next (or previous)
 * chapter differs between 數A and 數B, both cards render, labelled with the path; a script hides
 * the one off the learner's chosen path (prefs.mathPath). The default shows both.
 * A neighbour without a page yet shows as a "coming soon" card that is not a link.
 * At either end of a track the card leads back to the home page.
 */
import '../../styles/components.css';
import { chapterById, isReady, neighbours, pathsOf, subjectById, type Chapter } from '../../data/curriculum';
import { LOCALES, t, type Locale } from '../../i18n/ui';
import { localeOf, localizedPath } from '../../i18n/urls';

interface Props {
  current: string;
  built?: ReadonlySet<string>;
}
const { current, built } = Astro.props;
const curLocale = Astro.currentLocale;
const locale: Locale = LOCALES.includes(curLocale as Locale) ? (curLocale as Locale) : (localeOf(Astro.url.pathname) ?? 'zh-tw');
const hasPage = (id: string) => (built ? built.has(id) : isReady(id));

const here = chapterById(current);
const subjectDef = here && here.subject !== 'site' ? subjectById(here.subject) : undefined;
const paths = here ? pathsOf(here.subject).filter((p) => here.onPaths.includes(p)) : [];
const pathLabel = (id: string) => subjectDef?.paths.find((p) => p.id === id)?.label[locale] ?? id;

const L = {
  'zh-tw': { soon: '即將推出', soonNote: '這一章還在撰寫中。', first: '這是第一章', end: '這條路線到這裡結束', back: '回到首頁', sep: '・', sp: '' },
  en: { soon: 'Coming soon', soonNote: 'This chapter is still being written.', first: 'First chapter', end: 'End of this path', back: 'Back to home', sep: ' · ', sp: ' ' },
}[locale];

type Side = 'prev' | 'next';
interface Card {
  side: Side;
  path?: string;
  href?: string;
  /** only real neighbours get rel=prev/next, not the home fallback */
  rel?: Side;
  label: string;
  title: string;
  blurb?: string;
  soon?: boolean;
}

/** one card per distinct neighbour; `path` is set only when the learner's paths disagree */
function cards(which: Side): Card[] {
  // a chapter on one path only (e.g. 數A) must not point at a neighbour from the other path
  const perPath = paths.map((p) => ({ path: p as string | undefined, chapter: neighbours(current, p)[which] }));
  const distinct = new Set(perPath.map((x) => x.chapter?.id ?? ''));
  const list =
    perPath.length === 0 ? [{ path: undefined, chapter: neighbours(current)[which] }] : distinct.size === 1 ? [{ path: undefined, chapter: perPath[0].chapter }] : perPath;
  return list.map(({ path, chapter }) => card(which, chapter, path));
}

function card(which: Side, chapter: Chapter | undefined, path: string | undefined): Card {
  const word = t(locale, which === 'prev' ? 'chapter.prev' : 'chapter.next');
  const tag = path ? pathLabel(path) : undefined;
  const join = (...parts: (string | undefined)[]) => parts.filter(Boolean).join(L.sep);
  if (!chapter) {
    return { side: which, path, href: localizedPath(locale), label: join(which === 'prev' ? L.first : L.end, tag), title: L.back };
  }
  if (!hasPage(chapter.id)) {
    return {
      side: which,
      path,
      label: join(word, L.soon, tag),
      title: chapter.title[locale],
      blurb: `${chapter.blurb[locale]}${L.sp}${L.soonNote}`,
      soon: true,
    };
  }
  return {
    side: which,
    path,
    href: localizedPath(locale, ...chapter.id.split('/')),
    rel: which,
    label: which === 'prev' ? `← ${join(word, tag)}` : `${join(tag, word)} →`,
    title: chapter.title[locale],
  };
}

const all = here ? [...cards('prev'), ...cards('next')] : [];
---

{
  all.length > 0 && (
    <nav class="chapter-nav" aria-label={`${t(locale, 'chapter.prev')} / ${t(locale, 'chapter.next')}`}>
      {all.map((c) =>
        c.href ? (
          <a class={`cn-card cn-${c.side} card`} href={c.href} data-path={c.path} rel={c.rel}>
            <span class="label">{c.label}</span>
            <span class="cn-title">{c.title}</span>
          </a>
        ) : (
          <div class={`cn-card cn-${c.side} card cn-soon`} data-path={c.path}>
            <span class="label">{c.label}</span>
            <span class="cn-title">{c.title}</span>
            {c.blurb && <span class="cn-blurb">{c.blurb}</span>}
          </div>
        ),
      )}
    </nav>
  )
}

<script>
  import { readPrefs } from '../../lib/prefs';

  // at a 數A/數B branch, show only the learner's path once they have chosen one
  const choice = readPrefs().mathPath;
  const path = choice === 'A' ? 'mathA' : choice === 'B' ? 'mathB' : undefined;
  if (path) {
    document.querySelectorAll<HTMLElement>('.chapter-nav [data-path]').forEach((card) => {
      if (card.dataset.path) card.hidden = card.dataset.path !== path;
    });
  }
</script>
