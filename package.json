{
  "name": "gsat-zero-to-hero",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "學測 Zero-to-Hero: a free, bilingual (繁體中文/English) course for Taiwan's GSAT.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "astro dev --port 4331",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview --port 4332",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "astro check",
    "import:codes": "node scripts/import-codes.mjs",
    "assets": "node scripts/fonts.mjs && node scripts/katex-assets.mjs",
    "docs:curriculum": "node scripts/curriculum-doc.mjs",
    "prebuild": "npm run assets",
    "predev": "npm run assets"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.9",
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/react": "^7.1.9",
    "@astrojs/sitemap": "^3.7.5",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-sans-tc": "^5.3.1",
    "astro": "^7.4.12",
    "katex": "^0.16.47",
    "mafs": "^0.21.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "unist-util-visit": "^5.2.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "pagefind": "^1.6.0",
    "rehype-stringify": "^10.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "vitest": "^5.1.0"
  }
}
